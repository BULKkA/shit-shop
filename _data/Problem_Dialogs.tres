        }
      ],
      "cursed_object": [
        {
          "emotion": "neutral",
          "text": "Крестьяне нашли проклятую вещь и боятся к ней прикасаться. Я хочу отнести её туда, где её смогут очистить."
        },
        {
          "emotion": "shocked",
          "text": "Проклятый кубок сам пьёт воду из колодца. Не уверен, как это возможно, но деревня волнуется."
        }
      ],
      "missing_person": [
