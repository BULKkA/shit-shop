      ],
      "romantic_problem": [
        {
          "emotion": "smile",
          "text": "Один человек мне очень дорог, и я хочу сделать для него добрый поступок. Желательно не раздавить букет."
        },
        {
          "emotion": "shocked",
          "text": "Меня пригласили на свидание. Сражаться с чудовищами проще, чем выбрать правильные слова."
        }
      ]
    },
    "knight_girl": {
      "ancient_ruins": [
        {
          "emotion": "smile",
          "text": "Мне нужно спуститься в древние руины и проверить, не застрял ли там кто-нибудь. План простой: войти, помочь, не обвалить потолок."
        },
        {
          "emotion": "shocked",
          "text": "В руинах нашли странную дверь, и все почему-то смотрят на меня. Ладно, я уже надела шлем."
        }
      ],
      "bandit_camp": [
        {
          "emotion": "angry",
          "text": "Разбойники обижают путников. Я собираюсь прийти туда и очень убедительно объяснить, что так нельзя."
