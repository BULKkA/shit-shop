[resource]
data = {
    "wizard": {
      "ancient_ruins": [
        {
          "emotion": "neutral",
          "text": "Мне предстоит исследовать древние руины. Там ловушки, пыль и, вероятно, надписи, которые никто кроме меня не сможет прочитать."
        },
        {
          "emotion": "smile",
          "text": "В руинах нашли зал с магическими символами. Разумеется, без меня они там только красиво помрут."
        }
      ],
      "bandit_camp": [
        {
          "emotion": "neutral",
          "text": "Группа разбойников обосновалась слишком близко к моему маршруту. Мне нужен способ пройти мимо них с минимальным количеством идиотизма."
        },
        {
          "emotion": "angry",
          "text": "Разбойники украли ящик с моими реагентами. Я намерен вернуть его, желательно не превращая весь лагерь в жаб."
        }
      ],
      "lost_item": [
        {
          "emotion": "neutral",
          "text": "Я потерял важный компонент для ритуала. Он маленький, редкий и, к сожалению, не умеет сам возвращаться."
        },
        {
          "emotion": "shocked",
          "text": "Мой магический фокус исчез. Либо это кража, либо я впервые в жизни что-то забыл. Второй вариант невозможен."
        }
      ],
      "monster_hunt": [
        {
          "emotion": "neutral",
          "text": "В округе появилось чудовище, устойчивое к простым заклинаниям. Придётся применить менее простые решения."
        },
        {
          "emotion": "angry",
          "text": "Какое-то существо мешает моим наблюдениям. Его нужно прогнать, усмирить или убедить не существовать рядом со мной."
        }
      ],
      "escort_mission": [
        {
          "emotion": "neutral",
          "text": "Мне поручили сопроводить одного важного, но крайне шумного человека. Нужна вещь, которая облегчит это испытание."
        },
        {
          "emotion": "angry",
          "text": "Я должен провести караван через опасную дорогу. Хуже монстров там только разговоры караванщиков."
        }
      ],
      "locked_door": [
        {
          "emotion": "neutral",
          "text": "Передо мной дверь с древним замком. Открыть её грубой силой было бы вульгарно, но иногда полезно."
        },
        {
          "emotion": "smile",
          "text": "Я нашёл запертую дверь, явно скрывающую тайну. Или кладовку. В любом случае она меня оскорбляет."
        }
      ],
      "cursed_object": [
        {
          "emotion": "neutral",
          "text": "Ко мне попал проклятый предмет. Он шепчет, мерцает и явно переоценивает собственную опасность."
        },
        {
          "emotion": "shocked",
          "text": "Один артефакт начал спорить со мной по ночам. Мне нужно прекратить это, пока он не решил написать мемуары."
        }
      ],
      "missing_person": [
        {
          "emotion": "neutral",
          "text": "Исчез помощник исследователя. Его нужно найти, пока он не сломал что-нибудь древнее и бесценное."
        },
        {
          "emotion": "angry",
          "text": "Один ученик заблудился после моей лекции. Неприятно признавать, но придётся его спасать."
        }
      ],
      "forest_journey": [
        {
          "emotion": "neutral",
          "text": "Мне нужно пройти через лес, где деревья якобы двигаются. Наконец-то прогулка с интеллектуальным вызовом."
        },
        {
          "emotion": "smile",
          "text": "Маршрут лежит через чащу, полную духов и зверей. Возможно, хоть кто-то там поддержит умную беседу."
        }
      ],
      "mountain_pass": [
        {
          "emotion": "neutral",
          "text": "Мне предстоит пересечь горный перевал. Высота, холод и отсутствие библиотек делают задачу неприятной."
        },
        {
          "emotion": "angry",
          "text": "Дорога через горы закрыта снегом и суевериями местных. Нужно что-то, что поможет с обеими проблемами."
        }
      ],
      "haunted_house": [
        {
          "emotion": "neutral",
          "text": "В заброшенном доме замечена призрачная активность. Я должен изучить её, пока туда не пришли экзорцисты с колокольчиками."
        },
        {
          "emotion": "smile",
          "text": "Дом с привидениями может оказаться редким источником магических данных. Или просто домом с плохой вентиляцией."
        }
      ],
      "treasure_hunt": [
        {
          "emotion": "neutral",
          "text": "Я ищу легендарный клад, потому что среди золота может быть артефакт. Остальное золото, конечно, научный мусор."
        },
        {
          "emotion": "smile",
          "text": "Карта указывает на сокровище. Удивительно, но на этот раз она почти не врёт."
        }
      ],
      "village_problem": [
        {
          "emotion": "neutral",
          "text": "Деревня просит помощи с местной бедой. Описание расплывчатое, паника стабильная."
        },
        {
          "emotion": "angry",
          "text": "Жители уверены, что всё дело в магии. Как обычно, они называют магией всё, что не понимают."
        }
      ],
      "magic_experiment": [
        {
          "emotion": "smile",
          "text": "Я провожу эксперимент, который почти наверняка войдёт в историю. Возможно, как предупреждение."
        },
        {
          "emotion": "shocked",
          "text": "Один эксперимент вышел из-под контроля. Ничего критичного, если не считать дыру в потолке."
        }
      ],
      "royal_task": [
        {
          "emotion": "neutral",
          "text": "Знать поручила мне деликатное дело. Они называют это честью, я называю это проблемой в дорогой одежде."
        },
        {
          "emotion": "angry",
          "text": "Королевский совет требует немедленного результата. Как будто великие открытия делаются по расписанию."
        }
      ],
      "delivery_mission": [
        {
          "emotion": "neutral",
          "text": "Мне нужно доставить хрупкий магический свёрток. Он не должен упасть, намокнуть или начать петь."
        },
        {
          "emotion": "shocked",
          "text": "Посылка, которую я несу, иногда дышит. Вероятно, это нормально. Вероятно."
        }
      ],
      "survival": [
        {
          "emotion": "neutral",
          "text": "Мне придётся несколько дней провести вдали от удобств цивилизации. Ужасная перспектива."
        },
        {
          "emotion": "angry",
          "text": "Экспедиция задержалась, припасы заканчиваются, а мои спутники считают ягоды едой."
        }
      ],
      "strange_noise": [
        {
          "emotion": "neutral",
          "text": "В башне слышны странные звуки. Если это снова мыши в кристаллах, я буду недоволен."
        },
        {
          "emotion": "shocked",
          "text": "Ночью из подвала доносится хор голосов. У меня нет хора голосов в подвале. Пока что."
        }
      ],
      "festival_preparation": [
        {
          "emotion": "neutral",
          "text": "Меня втянули в подготовку праздника. Видимо, слово 'маг' для них означает 'человек для спецэффектов'."
        },
        {
          "emotion": "angry",
          "text": "Праздничный фейерверк нестабилен. Кто-то решил заменить расчёты энтузиазмом."
        }
      ],
      "romantic_problem": [
        {
          "emotion": "neutral",
          "text": "Мне нужно произвести благоприятное впечатление на одного человека. Теоретически это не сложнее ритуала призыва."
        },
        {
          "emotion": "shocked",
          "text": "Меня пригласили на встречу. Я подготовил три речи и ни одной нормальной эмоции."
        }
      ]
    },
    "elephant_paladin": {
      "ancient_ruins": [
        {
          "emotion": "smile",
          "text": "Я отправляюсь в древние руины, чтобы сопроводить туда деревенских исследователей. Там много ловушек, но я постараюсь принять удар на себя."
        },
        {
          "emotion": "neutral",
          "text": "В старом храме под землёй пропали паломники. Мне нужно добраться до них раньше, чем сработают древние механизмы."
        }
      ],
      "bandit_camp": [
        {
          "emotion": "neutral",
          "text": "Разбойники перекрыли дорогу и пугают путников. Я хочу решить это мирно, но доспехи я всё равно надел."
        },
        {
          "emotion": "angry",
          "text": "Лагерь разбойников напал на караван с лекарствами. Это уже не шалость, а настоящее бесчестие."
        }
      ],
      "lost_item": [
        {
          "emotion": "neutral",
          "text": "Я потерял священную печать ордена. Очень неловко, особенно потому что она размером с тарелку."
        },
        {
          "emotion": "shocked",
          "text": "У меня пропал походный талисман удачи. Без него я всё ещё храбр, но немного менее спокоен."
        }
      ],
      "monster_hunt": [
        {
          "emotion": "neutral",
