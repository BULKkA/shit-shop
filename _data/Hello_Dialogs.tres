[gd_resource type="JSON" format=3 uid="uid://q08kpufhlwpx"]

[resource]
data = {
"wizard": [
{
"emotion": "neutral",
"text": "Добрый день. Надеюсь, в этой лавке найдётся хоть что-то полезнее её владельца."
},
{
"emotion": "neutral",
"text": "Мне предстоит небольшая экспедиция. Посмотрим, есть ли у вас что-нибудь стоящее."
},
{
"emotion": "smile",
"text": "Хм. Пахнет пылью, старьём и сомнительными решениями. Возможно, я пришёл по адресу."
},
{
"emotion": "neutral",
"text": "Здравствуйте. Мне нужна одна необычная вещь для исследования."
},
{
"emotion": "angry",
"text": "Надеюсь, сегодня мне не придётся покупать очередную бесполезную безделушку."
},
{
"emotion": "smile",
"text": "Иногда великие открытия начинаются с весьма странных покупок."
},
{
"emotion": "neutral",
"text": "Я ищу решение проблемы. Или хотя бы источник вдохновения."
},
{
"emotion": "shocked",
"text": "Удивительно. Эта лавка всё ещё работает."
},
{
"emotion": "neutral",
"text": "Время дорого. Давайте перейдём к делу."
},
{
"emotion": "smile",
"text": "Посмотрим, способен ли случай сегодня превзойти магию."
}
],
"elephant_paladin": [
  {
    "emotion": "smile",
    "text": "Приветствую, друг! Мне бы что-нибудь полезное для путешествия."
  },
  {
    "emotion": "smile",
    "text": "Да осветит тебя солнце! Сегодня мне нужна небольшая помощь."
  },
  {
    "emotion": "neutral",
    "text": "Я отправляюсь в путь и надеюсь найти здесь что-нибудь полезное."
  },
  {
    "emotion": "smile",
    "text": "Каждый герой иногда нуждается в поддержке."
  },
  {
    "emotion": "neutral",
    "text": "Интересно, что судьба приготовила для меня сегодня."
  },
  {
    "emotion": "smile",
    "text": "Даже самая странная вещь может помочь в добром деле."
  },
  {
    "emotion": "shocked",
    "text": "Ого, ассортимент стал ещё больше с моего прошлого визита."
  },
  {
    "emotion": "neutral",
    "text": "Мне предстоит важное дело. Надеюсь на вашу помощь."
  },
  {
    "emotion": "smile",
    "text": "Рад снова заглянуть в эту лавку."
  },
  {
    "emotion": "angry",
    "text": "Очень надеюсь, что сегодня мне не продадут откровенную ерунду."
  }
],
"guard": [
  {
    "emotion": "smile",
    "text": "Привет! Мне срочно нужно что-нибудь полезное."
  },
  {
    "emotion": "neutral",
    "text": "Я собираюсь помочь людям. Осталось придумать как."
  },
  {
    "emotion": "smile",
    "text": "Что-нибудь для приключения найдётся?"
  },
  {
    "emotion": "shocked",
    "text": "Если честно, я пришла сюда раньше, чем придумала план."
  },
  {
    "emotion": "smile",
    "text": "Иногда хороший предмет лучше хорошего плана."
  },
  {
    "emotion": "neutral",
    "text": "Мне предстоит очередное задание."
  },
  {
    "emotion": "smile",
    "text": "Судьба любит смелых. Проверим?"
  },
  {
    "emotion": "shocked",
    "text": "Ого, сколько у вас здесь всего."
  },
  {
    "emotion": "angry",
    "text": "Только не говорите, что снова остались одни странные вещи."
  },
  {
    "emotion": "smile",
    "text": "Ладно, удивите меня."
  }
],
"elf": [
  {
    "emotion": "neutral",
    "text": "Приветствую. Мне предстоит путь через дикие земли."
  },
  {
    "emotion": "neutral",
    "text": "Я ищу вещь, которая поможет в дороге."
  },
  {
    "emotion": "smile",
    "text": "Лес полон неожиданностей. Лучше подготовиться заранее."
  },
  {
    "emotion": "neutral",
    "text": "Даже опытный следопыт иногда нуждается в удаче."
  },
  {
    "emotion": "smile",
    "text": "Любопытно, что найдётся среди ваших товаров."
  },
  {
    "emotion": "neutral",
    "text": "Сегодняшний маршрут обещает быть непростым."
  },
  {
    "emotion": "shocked",
    "text": "Удивительно, сколько вещей люди готовы хранить."
  },
  {
    "emotion": "neutral",
    "text": "Мне нужно кое-что для путешествия."
  },
  {
    "emotion": "angry",
    "text": "Надеюсь, здесь найдётся что-нибудь полезнее прошлой покупки."
  },
  {
    "emotion": "smile",
    "text": "Посмотрим, какую роль сегодняшняя находка сыграет в моей истории."
  }
],
"roge": [
  {
    "emotion": "smile",
    "text": "Приветик! Ничего не пропало? Тогда отлично."
  },
  {
    "emotion": "smile",
    "text": "Мне нужна вещь для одного совершенно законного мероприятия."
  },
  {
    "emotion": "shocked",
    "text": "Ого, а у тебя появились новые товары."
  },
  {
    "emotion": "smile",
    "text": "Сегодня я планирую попасть туда, куда меня не приглашали."
  },
  {
    "emotion": "neutral",
    "text": "Мне нужен инструмент для решения деликатной проблемы."
  },
  {
    "emotion": "smile",
    "text": "Иногда судьбу меняет всего одна безделушка."
  },
  {
    "emotion": "neutral",
    "text": "Надеюсь, сегодня мне повезёт."
  },
  {
    "emotion": "angry",
    "text": "Если снова предложишь мусор, я обижусь."
  },
  {
    "emotion": "smile",
    "text": "Не спрашивай зачем. Так будет веселее."
  },
  {
    "emotion": "shocked",
    "text": "Если всё получится, никто даже не узнает, что я здесь был."
  }
]
}


